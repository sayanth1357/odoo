<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record model="ir.module.category" id="module_category_properties_management">
            <field name="name">Properties</field>
            <field name="sequence">5</field>
        </record>
        <record model="res.groups.privilege" id="res_groups_privilege_properties1">
            <field name="name">Properties Management</field>
            <field name="category_id" ref="properties_management.module_category_properties_management"/>
        </record>
         <record id="group_property_user" model="res.groups">
           <field name="name">Property User</field>
           <field name="privilege_id" ref="res_groups_privilege_properties1" />
           <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
       </record>
       <record id="group_property_manager" model="res.groups">
           <field name="name">Property Manager</field>
           <field name="privilege_id" ref="res_groups_privilege_properties1" />
           <field name="implied_ids" eval="[(4, ref('group_property_user'))]" />
           <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]" />
       </record>
    </data>
    <data>
        <record model="ir.module.category" id="module_category_rental_lease_management">
            <field name="name">Rental lease Management</field>
            <field name="sequence">5</field>
        </record>
        <record model="res.groups.privilege" id="res_groups_privilege_rentlease">
            <field name="name">Rental Lease Management</field>
            <field name="category_id" ref="properties_management.module_category_rental_lease_management"/>
        </record>
         <record id="group_rent_lease_user" model="res.groups">
           <field name="name">Rent Lease User</field>
           <field name="privilege_id" ref="res_groups_privilege_rentlease" />
           <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />

       </record>
       <record id="group_rent_lease_manager" model="res.groups">
           <field name="name">Rent Lease Manager</field>
           <field name="privilege_id" ref="res_groups_privilege_rentlease" />
           <field name="implied_ids" eval="[(4, ref('group_property_user'))]" />
           <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]" />

       </record>
    </data>
</odoo>