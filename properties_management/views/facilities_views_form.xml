<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id = "view_facilities_list"  model="ir.ui.view">
        <field name="name">Facilities Management</field>
        <field name="model">facilities.facilities</field>
        <field name="arch" type="xml">
            <list>
                    <field name="facility_name" />
                    <field name="facility_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id = "view_facilities_form"  model="ir.ui.view">
        <field name="name">Facilities Management</field>
        <field name="model">facilities.facilities</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="facility_name" create="0"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>