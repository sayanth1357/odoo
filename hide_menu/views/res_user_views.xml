<?xml version="1.0" encoding="utf-8"?>
<odoo>
   <record id="view_user_form_inherit_hide_menu" model="ir.ui.view">
       <field name="name">res.users.form.inherit.hide.menu</field>
       <field name="model">res.users</field>
       <field name="inherit_id" ref="base.view_users_form"/>
       <field name="arch" type="xml">
           <xpath expr="//field[@name='role']" position="after">
               <field name="hide_specific_menu" widget="many2many_tags"/>
           </xpath>
       </field>
   </record>
</odoo>
