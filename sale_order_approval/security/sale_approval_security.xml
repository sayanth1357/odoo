<?xml version="1.0" encoding="UTF-8"?>
<odoo>
   <data>
       <record model="ir.module.category" id="module_category_sale_order_approval">
           <field name="name"> approval</field>
           <field name="sequence">5</field>
       </record>
       <record model="res.groups.privilege" id="res_groups_privilege_approval">
           <field name="name">Sale approval</field>
           <field name="category_id" ref="sale_order_approval.module_category_sale_order_approval"/>
       </record>

       <!-- subscription user group-->
       <record id="group_sale_salesman" model="res.groups">
           <field name="name">Sale User</field>
           <field name="privilege_id" ref="res_groups_privilege_approval" />
           <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
       </record>
       <!-- subscription manager group-->
       <record id="group_sale_manager" model="res.groups">
           <field name="name">Sale Manager</field>
           <field name="privilege_id" ref="res_groups_privilege_approval" />
           <field name="implied_ids" eval="[(4, ref('group_sale_salesman'))]" />
           <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]" />
       </record>
   </data>
</odoo>


