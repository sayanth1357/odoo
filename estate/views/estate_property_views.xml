<odoo>
    <record id="estate_model_action" model="ir.actions.act_window">
        <field name="name">Test action</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form</field>
    </record>



    <record id="estate_model_view1" model="ir.ui.view">
        <field name="name">estate.property</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list string="tests">
                <field name="name"/>
                <field name="postcode"/>
                <field name="bedrooms"/>
                <field name="date_availability"/>
                <field name="active"/>
            </list>
             </field>
    </record>



    <record id="estate_model_view_form" model="ir.ui.view">
        <field name="name">estate.property</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="test">
                <sheet>
                    <header>
                        <button name="sold_btn" type="object" string="sold"/>
                        <button name="cancel_btn" type="object" string="cancel"/>


                    </header>
                    <h1>
                        <group>
                                 <field name="name"/>
                        </group>
                    </h1>
                    <group>
                        <group>
                            <field name="property_tag_id" widget="many2many_tags"/>
                            <field name="postcode"/>
                            <field name="date_availability"/>
                             <field name="property_type_id"/>
                        </group>
                        <group>
                            <field name="expected_price"/>
                            <field name="selling_price"/>
                            <field name="best_offer"/>
                        </group>
                    </group>
                    <notebook>

                        <page string="Description">
                            <group>
                                    <field name="description"/>
                                    <field name="bedrooms"/>
                                    <field name="living_area"/>
                                    <field name="facades"/>
                                    <field name="garage"/>
                                    <field name="garden"/>
                                    <field name="garden_area"/>
                                    <field name="garden_orientation"/>
                                    <field name="status"/>
                                    <field name="total_area"/>
                            </group>
                        </page>



                        <page string="Offers">
                            <field  name="property_offer_ids" >
                            <list string="test3">
                                <field name="price"/>
                                <field name="partner_id"/>
                                <field name="status"/>
                                <field name="validity" />
                                <field name="date_deadline"/>


                            </list>
                            </field>
                        </page>


                        <page string="Other Info">
                            <group>
                                <field name="salesman_id"/>
                                <field name="partner_id"/>
                            </group>
                        </page>

                    </notebook>
                </sheet>
            </form>
        </field>
    </record>



    <record id="estate_model_view2_search" model="ir.ui.view">
        <field name="name">estate.property</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="test1">
                <field name="name"/>
                <filter name="status" domain="['|','|','|','|',('status','=','new'),('status','=','offer received'),('status','=','offer accepted'),('status','=','sold'),('status','=','cancelled')]"/>
                <filter name="n11" domain="[('expected_price','>',500)]"/>

            </search>
        </field>
    </record>

</odoo>