<?xml version="1.0" encoding="UTF-8"?>

<odoo>
     <record id="recurring_prod_action" model="ir.actions.act_window">
        <field name="name">Product order lines</field>
        <field name="res_model">product.order.lines</field>
        <field name="view_mode">list,form</field>
    </record>


    <record id="rec_prod_list" model="ir.ui.view">
        <field name="name">product.order.lines</field>
        <field name="model">product.order.lines</field>
        <field name="arch" type="xml">
            <list string="prodlist">

                <field name="product_template_id"/>
                <field name="quantity"/>
                <field name="price"/>
            </list>
        </field>
    </record>


    <record id="rec_sub_product_view" model="ir.ui.view">
           <field name="name">product.order.lines</field>
           <field name="model">product.order.lines</field>
           <field name="arch" type="xml">
             <form string="prodform">
                 <sheet>
                     <group>
                         <field name="order_lines_id"/>
                         <field name="product_template_id"/>
                         <field name="quantity"/>
                         <field name="price"/>
                     </group>
                 </sheet>
             </form>
           </field>
       </record>
</odoo>