<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <record id="billing_schedule_action" model="ir.actions.act_window">
        <field name="name">Billing Schedule</field>
        <field name="res_model">billing.schedule</field>
        <field name="view_mode">list,form</field>
    </record>


    <record id="billing_schedule_view_list" model="ir.ui.view">
      <field name="name">billing.schedule</field>
      <field name="model">billing.schedule</field>
      <field name="arch" type="xml">
          <list string="bill">
              <field name="billing_name"/>
              <field name="recurring_subscription_ids"/>
              <field name="simulation_boolean"/>
          </list>
      </field>
    </record>

  <record id="billing_schedule_view_form" model="ir.ui.view">
      <field name="name">billing.schedule</field>
      <field name="model">billing.schedule</field>
      <field name="arch" type="xml">
          <form string="billing">
              <sheet>
                  <div class="oe_button_box" name="button_box">
                      <button name="action_rec_sub"
                              type="object"
                              class="oe_stat_button">
<!--                              icon="fa_refresh">-->
                          <field name="recurring_subscription_ids"
                                 widget="statinfo"
                                 string="subscription"/>
                      </button>
                  </div>

                  <group>
                      <field name="billing_name"/>
                      <field name="simulation_boolean"/>
                      <field name="date_begin"  widget="daterange" options="{'end_date_field': 'date_end'}"/>
                      <field name="date_end" invisible="1"/>
                      <field name="customer_id" widget="many2many_tags"/>
                      <field name="recurring_subscription_ids" widget="many2many_tags"/>
                      <field name="currency_id" invisible="1"/>"
                      <field name="total_credit_amount"/>

                  </group>

                  <notebook>
                      <page string="Credits">
                          <field name="credits_ids"/>
                      </page>
                  </notebook>
              </sheet>
          </form>
      </field>
  </record>


</odoo>