<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="recurring_sub_action" model="ir.actions.act_window">
        <field name="name">Recurring subscription</field>
        <field name="res_model">recurring.subscription</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="rec_sub_view1" model="ir.ui.view">
        <field name="name">recurring.subscription</field>
        <field name="model">recurring.subscription</field>
        <field name="arch" type="xml">
            <list string="tests">
                <field name="id_order"/>
                <field name="name"/>
                <field name="customer_id"/>
                <field name="product_id"/>
                <field name="recurring_amount"/>
<!--                <field name="currency_id"/>-->
            </list>
        </field>
    </record>


    <record id="recurring_sub_view_form" model="ir.ui.view">
        <field name="name">recurring.subscription</field>
        <field name="model">recurring.subscription</field>
        <field name="arch" type="xml">
            <form string="sub">
<!--                <field name="status" widget="statusbar"  statusbar_visible="draft,confirm,done,cancel"/>-->
                <header>
                       <field name="status" widget="statusbar"  statusbar_visible="draft,confirm,done" readonly="1"/>
                        <button  type="object" string="Confirm" name="action_confirm_btn" class="btn-primary"
                                 invisible="status in['confirm','cancel','done'] " groups="recurring_subscription.group_subscription_manager"/>
                        <button type="object" string="cancel" name="action_cancel_btn"
                                invisible="status not in ['draft', 'confirm', 'done'] or not id "/>
                        <button type="object" string="Done" name="action_done_btn"
                                invisible="status not in ['draft', 'confirm','cancel'] or not id "/>
                </header>

                <sheet>
                    <h1>
                        <field name="id_order"/>
                    </h1>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="id_establishment"/>
<!--                            <field name="id_order"/>-->
                            <field name="company_id"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="recurring_amount"/>
                            <field name="date"/>
                            <field name="due_date"/>
                            <field name="next_billing"/>
                            <field name="total_credit_applied"/>
                        </group>
                        <group>
                            <field name="is_lead"/>
                            <!--                           <field name="status"/>-->
                            <field name="customer_id"/>
                            <field name="product_id"/>
                            <field name="billing_schedule"/>
                            <field name="count"/>
                            <field name="product_filter_ids" widget="many2many_tags"/>
                        </group>
                    </group>


                    <notebook>
                        <page string="Recurring subscription credit">

                                 <list string="tes1">
                                         <field name="recurring_subscription_credit_ids"/>

                                 </list>
                        </page>
                        <page string="Description">
                                <field name="description"/>
                        </page>
                        <page string="Terms and Condition">
                                <field name="terms_and_condition"/>
                        </page>
                        <page string="Order lines">
                            <list string="prod">
                                <field name="order_lines_ids"/>
                            </list>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>

    </record>

      <record id="recurring_subscription_view_search" model="ir.ui.view">
        <field name="name">recurring.subscription</field>
        <field name="model">recurring.subscription</field>
        <field name="arch" type="xml">
            <search string="test2">
                <field name="name"/>
                <field name="product_id"/>
                <field name="customer_id"/>
                <field name="id_establishment"/>
                <field name="status"/>
                <filter name="netflix" domain="[('product_id','=','Netflix subscription')]" />
                <filter name="est_id" domain="[('id_establishment','=','net@123#')]"/>
<!--                <group expand="0" string="Group By">-->
                <filter string="Product" name="product_group"  context="{'group_by': 'product_id'}"/>
                <filter string="Customer" name="customer_group"  context="{'group_by': 'customer_id'}"/>
                <filter string="Establishment id" name="product_group"  context="{'group_by': 'id_establishment'}"/>
                <filter string="Status" name="product_group"  context="{'group_by': 'status'}"/>
<!--                </group>-->

            </search>
        </field>
    </record>

</odoo>