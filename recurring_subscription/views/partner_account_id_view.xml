<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <record id="partner_account_id_action" model="ir.actions.act_window">
        <field name="name">Partner Account ID</field>
        <field name="res_model">partner.account.id</field>
        <field name="view_mode">list,form</field>
    </record>



    <record id="partner_account_id_view_list" model="ir.ui.view">
        <field name="name">partner.account.id</field>
        <field name="model">partner.account.id</field>
        <field name="arch" type="xml">
            <list string="partnerlist">
                <field name="id_account"/>
                <field name="partner_id"/>
            </list>
        </field>
    </record>


    <record id="partner_account_id_view_form" model="ir.ui.view">
        <field name="name">partner.account.id</field>
        <field name="model">partner.account.id</field>
        <field name="arch" type="xml">
            <form string="partnerform">
                <sheet>
                    <group>
                        <field name="id_account"/>
                        <field name="partner_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>