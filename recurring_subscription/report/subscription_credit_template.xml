<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="rec_sub_credit_report">
            <t t-call="web.html_container">
<!--                <t t-foreach="docs" t-as="o">-->
                    <t t-call="web.external_layout">
                        <div class="page">
                            <div class="oe_structure"/>
                            <div class="text-center">
                                <h1> Subscription Credit Report</h1>
                            </div>
                            <t t-if="length==1">
                                <div>
                                    <h5>State: <span t-out="state[0]"/> </h5>
                                </div>
                            </t>
                             <table class="table table-bordered mb64 ">
                                <thead>
                                     <tr>
                                         <th><strong>SL.No</strong></th>
                                         <th><strong>Subscription</strong></th>
                                         <th><strong>Customer</strong></th>
                                         <th><strong>Amount applied</strong></th>
                                         <th><strong>Amount pending</strong></th>
                                         <t t-if="length!=1">
                                            <th><strong>State</strong></th>
                                         </t>
                                     </tr>
                                </thead>
                                <tbody>
                                    <t t-set="sl_no" t-value="1"/>
                                    <t t-foreach="data.get('report')" t-as="credit">
                                        <tr>
                                            <td>
                                                <t t-esc="sl_no"/>
                                            </td>
                                            <td>
                                                <t t-esc="credit['subscription']"/>
                                            </td>
                                            <td>
                                                <t t-esc="credit['customer']"/>
                                            </td>
                                            <td>
                                                <t t-esc="credit['amount_applied']"/>
                                            </td>
                                            <td>
                                                <t t-esc="credit['pending_amount']"/>
                                            </td>
                                            <t t-if="length!=1">
                                                <td>
                                                    <t t-esc="credit['state']"/>
                                                </td>
                                            </t>
                                        </tr>
                                        <t t-set="sl_no" t-value="sl_no+1"/>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </t>
<!--                </t>-->
            </t>
     </template>

</odoo>
