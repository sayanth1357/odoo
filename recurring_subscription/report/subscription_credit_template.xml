<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="rec_sub_credit_report">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <div class="text-center">
                                <h1> Subscription Credit Report</h1>
                            </div>
                            <h3>Customer:
                                <span t-field="o.name"/>
                                <span t-field="o.customer_id"/>
                            </h3>
                             <table class="table">
                                <thead>
                                     <tr>
                                         <th>SL.No</th>
                                         <th>Subscription></th>
                                         <th>Customer</th>
                                         <th>Amount applied</th>
                                         <th>Amount pending</th>
                                         <th>State</th>
                                     </tr>
                                </thead>
                                <tbody>
                                    <t t-set="sl_no" t-value="1"/>
                                    <t t-foreach="docs" t-as="credit">
                                        <tr>
                                            <td>
                                                <t t-esc="sl_no"/>
                                            </td>
                                            <td>
                                                <t t-esc="credit.recurring_subscription_id"/>
                                            </td>
                                            <td>
                                                <t t-esc="credit.partner_id"/>
                                            </td>
                                            <td>
                                                <t t-esc="credit.credit_amount"/>
                                            </td>
                                            <td>
                                                <t t-esc="credit.state"/>
                                            </td>
                                        </tr>
                                        <t t-set="sl_no" t-value="sl_no+1"/>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </t>
                </t>
            </t>
     </template>

</odoo>
