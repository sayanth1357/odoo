<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="form_r_s_report">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <div class="text-center">
                                <h1>Subscription Report</h1>
                            </div>

                             <table class="table">
                                <thead>
                                     <tr>
                                         <th>SL.No</th>
                                         <th>Name</th>
                                         <th>Customer</th>
                                         <th>Product</th>
                                         <th>Amount</th>
                                         <th>Status</th>
                                     </tr>
                                </thead>
                                <tbody>
                                    <t t-set="sl_no" t-value="1"/>
                                    <t t-foreach="docs" t-as="o">
                                        <tr>
                                            <td>
                                                <t t-esc="sl_no"/>
                                            </td>
                                            <td>
                                                <t t-esc="o['name']"/>
                                            </td>
                                            <td>
                                                <t t-esc="o['customer_id'].name"/>
                                            </td>
                                            <td>
                                                <t t-esc="o['product_id'].name"/>
                                            </td>
                                            <td>
                                                <t t-esc="o['recurring_amount']"/>
                                            </td>
                                            <td>
                                                <t t-esc="o['status']"/>
                                            </td>
                                        </tr>
                                        <t t-set="sl_no" t-value="sl_no+1"/>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </t>
                </t>
            </t>
     </template>
</odoo>
