<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="form_r_s_report">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                        <div class="page">
                            <div class="oe_structure"/>
                            <div class="text-center">
                                <h1>Subscription Report</h1>
                            </div>
                            <t t-if="name_len==1">
                                 <div>
                                        <h4>Name: <span t-out="subname[0]"/></h4>
                                 </div>
                            </t>
                            <t t-if="length==1">
                                    <div>
                                        <h4>status: <span t-out="subs[0]"/></h4>
                                    </div>
                            </t>

                            


                             <table class="table table-bordered mb64">
                                <thead>
                                     <tr>
                                         <th><strong>SL.No</strong></th>
                                         <t t-if="name_len!=1">
                                            <th><strong>Name</strong></th>
                                         </t>
                                         <th><strong>Customer</strong></th>
                                         <th><strong>Product</strong></th>
                                         <th><strong>Amount</strong></th>
                                         <th><strong>Total credit applied</strong></th>
                                         <t t-if="length!=1">
                                            <th><strong>Status</strong></th>
                                         </t>
                                     </tr>
                                </thead>
                                <tbody>
                                    <t t-set="sl_no" t-value="1"/>
                                    <t t-foreach="data.get('report')" t-as="o">
                                        <tr>
                                            <td>
                                                <t t-esc="sl_no"/>
                                            </td>
                                            <t t-if="name_len!=1">
                                                <td>
                                                    <t t-esc="o['name']"/>
                                                </td>
                                            </t>
                                            <td>
                                                <t t-esc="o['customer']"/>
                                            </td>
                                            <td>
                                                <t t-esc="o['product']"/>
                                            </td>
                                            <td>
                                                <t t-esc="o['recurring_amount']"/>
                                            </td>
                                            <td>
                                                <t t-esc="o['total_credit_applied']"/>
                                            </td>
                                            <t t-if="length!=1">
                                                <td>
                                                    <t t-esc="o['status']"/>
                                                </td>
                                            </t>
                                        </tr>
                                        <t t-set="sl_no" t-value="sl_no+1"/>
                                    </t>
                                </tbody>
                            </table>
                            <div>
                                 <t t-if="term">
                                    <div>
                                        <h5><strong>Terms and condition:</strong></h5>
                                        <t t-raw="term"/>
                                    </div>
                                </t>
                            </div>
                        </div>
                </t>
            </t>
     </template>
</odoo>
