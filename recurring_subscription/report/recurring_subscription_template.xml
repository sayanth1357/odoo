<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="form_recurring_subscription_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="text-center">
                            <h1>Subscription Report</h1>
                        </div>
                        <h3>Customer:
                            <span t-field="o.name"/>
                            <span t-field="o.customer_id"/>
                        </h3>

                         <table class="table">
                            <thead>
                                 <tr>
                                     <th>SL.No</th>
                                     <th>Name></th>
                                     <th>Customer</th>
                                     <th>Product</th>
                                     <th>Amount</th>
                                     <th>Total Credit Applied</th>
                                     <th>State</th>
                                 </tr>
                            </thead>
                            <tbody>
                                <tr>

                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
 </template>


</odoo>
