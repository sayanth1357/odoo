<?xml version="1.0" encoding="UTF-8"?>
<odoo>
   <data>
       <record model="ir.module.category" id="module_category_recurring_subscription">
           <field name="name">subscription</field>
           <field name="sequence">5</field>
       </record>
       <record model="res.groups.privilege" id="res_groups_privilege_subscription">
           <field name="name">Recurring subscription</field>
           <field name="category_id" ref="recurring_subscription.module_category_recurring_subscription"/>
       </record>

       <!-- subscription user group-->
       <record id="group_subscription_user" model="res.groups">
           <field name="name">Subscription User</field>
           <field name="privilege_id" ref="res_groups_privilege_subscription" />
           <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
       </record>
       <!-- subscription manager group-->
       <record id="group_subscription_manager" model="res.groups">
           <field name="name">Subscription Manager</field>
           <field name="privilege_id" ref="res_groups_privilege_subscription" />
           <field name="implied_ids" eval="[(4, ref('group_subscription_user'))]" />
           <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]" />
       </record>

      <!--   company rule-->
        <record id="recurring_subscription_company_rule" model="ir.rule">
            <field name="name">Subscription Multi-Company</field>
            <field name="model_id" ref="model_recurring_subscription"/>
            <field name="domain_force">[('company_id', 'in',company_ids + [False])]</field>
        </record>

        <record id="recurring_subscription_credit_company_rule" model="ir.rule">
            <field name="name">Subscription Multi-Company</field>
            <field name="model_id" ref="model_recurring_subscription_credit"/>
            <field name="domain_force">[('company_id', 'in',company_ids + [False])]</field>
        </record>

        <record id="billing_schedule_company_rule" model="ir.rule">
            <field name="name">Subscription Multi-Company</field>
            <field name="model_id" ref="model_billing_schedule"/>
            <field name="domain_force">[('company_id', 'in',company_ids + [False])]</field>
        </record>

   </data>
</odoo>

