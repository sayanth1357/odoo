<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <data>
        <!--Template to send demo mail template for the customer-->
        <record id="mail_template_recurring_subscription" model="mail.template">
            <field name="name">Email Template For Recurring subscription</field>
            <field name="model_id" ref="recurring_subscription.model_recurring_subscription"/>
            <field name="email_from">${{ user.email_formatted or user.company_id.email_formatted }}</field>
            <field name="email_to">${{object.customer_id.id}}</field>
            <field name="subject">Recurring subscription done</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; font-size: 14px; color: #333;">
                          <p>Dear
                            <strong>
                                <t t-out="object.customer_id.name"/>
                            </strong>,
                          </p>
                           <p>
                                 We are pleased to inform you that your subscription is done.
                           </p>
                         <p style="margin-top: 20px;">
                            <strong>Product:</strong>
                            <t t-out="object.product_id.name"/>
                        </p>
                        <p style="margin-top: 20px;">
                            <strong>Total Amount:</strong>
                            <t t-out="object.recurring_amount"/>
                        </p>

                        <p>Best Regards,</p>
                        <p>
                            <strong>
                                <t t-out="object.company_id.name"/>
                            </strong>
                        </p>


                </div>
            </field>
        </record>
    </data>

</odoo>
