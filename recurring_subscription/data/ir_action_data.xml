<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">

    <!-- Server Action: Create Invoice from Sale Order -->
    <record id="action_send_email_on_status_done" model="ir.actions.server">
        <field name="name">Send email </field>
        <field name="model_id" ref="recurring_subscription.model_recurring_subscription"/>
        <field name="state">code</field>
        <field name="code">
            action= record.action_done_btn()
        </field>

    </record>
     <!-- Automated Action: Trigger on status Done -->
    <record id="automated_action_send_email_on_status_done" model="base.automation">
        <field name="name">Send email when status is done</field>
        <field name="model_id" ref="recurring_subscription.model_recurring_subscription"/>
        <field name="trigger">on_write</field>
        <field name="filter_domain">[('status', '=', 'done')]</field>
        <field name="action_server_ids" eval="[(4, ref('action_send_email_on_status_done'))]"/>
    </record>
</data>
</odoo>
