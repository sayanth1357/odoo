<?xml version="1.0" encoding="utf-8"?>
<odoo>
   <record id="product_template_purchase_wizard_form_inherit_quantity" model="ir.ui.view">
       <field name="name">purchase.order.wizard.form.inherit.quantity</field>
       <field name="model">purchase.order.wizard</field>
       <field name="arch" type="xml">
           <form string="Automated po">
               <group>
                   <field name="product_id"/>
                   <field name="quantity"/>
                   <field name="currency_id" invisible="1"/>
                   <field name="price"/>
               </group>
               <footer>
                   <button string="confirm" name="confirm_btn" type="object"  class="btn-primary"/>
                   <button string="Cancel"  type="object" special="cancel"/>
               </footer>
           </form>
       </field>
   </record>
</odoo>
