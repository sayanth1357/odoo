<?xml version="1.0" encoding="utf-8"?>
<odoo>
   <record id="view_product_form_inherit_average_cost" model="ir.ui.view">
       <field name="name">product.template.form.inherit.average.cost</field>
       <field name="model">product.template</field>
       <field name="inherit_id" ref="product.product_template_only_form_view"/>
       <field name="arch" type="xml">
           <xpath expr="//field[@name='supplier_taxes_id']" position="after">
               <field name="average_cost" />
           </xpath>
       </field>
   </record>
</odoo>
