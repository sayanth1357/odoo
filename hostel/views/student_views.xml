<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="student_action" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">student</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="student_form" model="ir.ui.view">
        <field name="name">student.form</field>
        <field name="model">student</field>
        <field name="arch" type="xml" >
            <form string="student_form">
                <header>
                    <button name="student_action_alot_room" type="object" string="Alot Room"/>
                </header>
                <sheet>
                     <div class="mb8">
                        <div class="d-flex gap-3">
                            <field name="image" widget="contact_image" />
                            <div class="d-flex flex-column flex-grow-1">

                                <h1 class="mb-0 w-md-75">
                                    <field name="name" placeholder="Name" nolabel="1"/>
                                </h1>

                                <div class="d-flex align-items-baseline w-md-50">
                                    <i class="fa fa-fw me-1 fa-envelope text-primary" title="Email"/>
                                    <field name="email" class="w-100" widget="email" placeholder="Email "/>
                                </div>

                            </div>
                        </div>
                    </div>

                    <group>
                             <group>
                                 <field name="student_id"/>
                            </group>
                             <group>
                                <field name="dob"/>
                            </group>
                            <group>
                                <field name="age"/>
                            </group>
                             <group>
                                <field name="room_id"/>
                            </group>

                            <group>
                                 <field name="receive_email"/>
                            </group>
                            <group>
                                 <field name="company_id"/>
                            </group>
                        </group>

                    <notebook>
                        <page string="Other Info">
                            <group string="Address">
                                <group>
                                    <field name="street"/>
                                </group>
                                 <group>
                                    <field name="street2"/>
                                </group>
                                <group>
                                    <field name="city"/>
                                </group>
                                <group>
                                     <field name="state_id"/>
                                </group>
                                <group>
                                     <field name="zip"/>
                                </group>
                                <group>
                                     <field name="country_id"/>
                                </group>

                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="student_list" model="ir.ui.view">
        <field name="name">student.list</field>
        <field name="model">student</field>
        <field name="arch" type="xml">
                <list string="Students list">
                    <field name="name"/>
                    <field name="student_id"/>
                    <field name="room_id"/>
                    <field name="email"/>
                </list>
        </field>
    </record>
</odoo>