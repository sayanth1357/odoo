<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
<!--    PLACEHOLDER TEMPLATE -->
   <template id="category_hostel_room" name="Hostel Rooms">
       <section class="categories_section">
           <div class="container">
               <div class="alert alert-info">
                   <h4>No Rooms available...</h4>
               </div>
           </div>
       </section>
   </template>
<!--    EXTEND AND ADD TEMPLATE TO website.snippets -->
   <template id="category_hostel_room_snippet" inherit_id="website.snippets"
             name="Category Highlight Snippet">
       <xpath expr="//snippets[@id='snippet_groups']" position="inside">
           <t t-snippet="hostel.category_hostel_room"
              t-thumbnail="/hostel/static/img/placeholder.jpeg"/>
       </xpath>
       <xpath expr="//snippets[@id='snippet_structure']" position="inside">
           <t t-snippet="hostel.category_hostel_room"/>
       </xpath>
   </template>
</odoo>
