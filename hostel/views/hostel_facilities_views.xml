<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="hostel_facilities_view_list" model="ir.ui.view">
        <field name="name">hostel.facilties.list</field>
        <field name="model">hostel.facilities</field>
        <field name="arch" type="xml">
            <list string="Hostel facilities list">
                <field name="name"/>
                <field name="charge"/>
            </list>
        </field>
    </record>

    <record id="hostel_facilities_view_form" model="ir.ui.view">
        <field name="name">hostel.facilities.form</field>
        <field name="model">hostel.facilities</field>
        <field name="arch" type="xml">
            <form string="Hostel facilities form">

                <sheet>
                    <group>
                        <group><field name="name"/></group>
                        <group><field name="charge"/></group>
                        <group><field name="company_id"/></group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hostel_facilities_view_search" model="ir.ui.view">
        <field name="name">hostel.facilities.search</field>
        <field name="model">hostel.facilities</field>
        <field name="arch" type="xml">
            <search string="Hostel facilities  search">
                <field name="name"/>
                <field name="charge"/>
                <field name="company_id"/>
                <separator/>
                <group>
                    <filter name="group_by_company" string="Company" context="{'group_by':'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="hostel_facilities_action" model="ir.actions.act_window">
        <field name="name">Hostel Facilities</field>
        <field name="res_model">hostel.facilities</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>