<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="leave_request_report_view_form" model="ir.ui.view">
        <field name="name">leave.request.report.form</field>
        <field name="model">leave.request.report</field>
        <field name="arch" type="xml">
            <form string="leave requests">
                <group>
                    <field name="room_ids" widget="many2many_tags"/>
                    <field name="student_ids" widget="many2many_tags" invisible="not room_ids" domain="[('room_id','in',room_ids)]"/>
                    <field name="start_date"/>
                    <field name="arrival_date" invisible="not start_date"/>
                </group>
                <footer>
                    <button name="action_print_pdf" type="object" string="PDF" class="btn-primary"/>
                    <button name="action_print_xlsx" type="object" string="XLSX" class="btn-primary"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_leave_request_report" model="ir.actions.act_window">
        <field name="name">Leave Request Report</field>
        <field name="res_model">leave.request.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>