<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
        <record id="module_category_hostel_room_access" model="ir.module.category">
            <field name="name">Hostel</field>
        </record>

        <record id="privilege_hostel_room_access" model="res.groups.privilege">
            <field name="name">Hostel Room</field>
            <field name="category_id" ref="module_category_hostel_room_access"/>
        </record>

        <record id="group_warden" model="res.groups">
            <field name="name">Warden</field>
            <field name="privilege_id" ref="privilege_hostel_room_access"/>
            <field name="comment">Full access to rooms, students, facilities , can approve leave request, create cleaning request.</field>
        </record>

        <record id="group_student" model="res.groups">
            <field name="name">Student</field>
            <field name="privilege_id" ref="privilege_hostel_room_access"/>
            <field name="comment">See their own records in rooms, students, leave request, can create and edit leave request.</field>
        </record>
        <record id="group_staff" model="res.groups">
            <field name="name">Staff</field>
            <field name="privilege_id" ref="privilege_hostel_room_access"/>
            <field name="comment">Se and  their own and unassigned cleaning requests, can update cleaning request</field>
        </record>

</odoo>