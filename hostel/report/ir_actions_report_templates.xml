<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
<!--    HOSTEL ROOM REPORT TEMPLATE-->
    <template id="report_hostel_rooms">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Hostel Room Report</h2>
                        <p>ROOM NO : <span t-out="o.room_no">value</span></p>
                        <p>
                            <t t-out="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d')"/>
                        </p>
                        <table class=" table  table-borderless">
                            <thead>
                                <tr>
                                    <th class="text-start">SL
                                        No.
                                    </th>
                                    <th
                                        class="text-end text-nowrap">Name
                                    </th>
                                    <th
                                        class="text-end text-nowrap">Pending
                                        Amount
                                    </th>
                                    <th
                                        class="text-end text-nowrap">Room
                                    </th>
                                    <th
                                        class="text-end text-nowrap">Invoice
                                        Status
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td t-out="o.room_no"
                                        class="text-start">value</td>
                                    <td t-out="o.room_type_id.name"
                                        class="text-end">value</td>
                                    <td t-out="o.rent" class="text-end">value</td>
                                    <td t-out="o.no_of_beds"
                                        class="text-end">value</td>
                                    <td t-out="o.state" class="text-end">value</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
<!--      STUDENT REPORT TEMPLATE-->
    <template id="report_student_student">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>Student Report</h2>
                <t t-if="'filter_data' in docs" >
                    <t t-if="docs['filter_data']">
                        <t t-if="docs['filter_data'].get('student_ids')">
                            <p>STUDENT :
                                <t t-foreach="docs['filter_data'].get('student_ids')"
                                   t-as="students">
                                    <span t-out="students.upper()"></span>,
                                </t>
                            </p>
                        </t>
                        <t t-if="docs['filter_data'].get('room_ids')">
                            <p>ROOM :
                                <t t-foreach="docs['filter_data'].get('room_ids')"
                                   t-as="rooms">
                                    <span t-out="rooms"></span>,
                                </t>
                            </p>
                        </t>
                        <t t-if="docs['filter_data'].get('from_date')">
                            <p>PERIOD :
                                <span t-out="docs['filter_data'].get('from_date')"></span>
                                -
                                <span t-out="docs['filter_data'].get('to_date')"></span>
                            </p>
                        </t>
                    </t>
                    </t>
                    <p>
                        <span>ISSUED DATE :</span>
                        <t t-out="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d')"/>
                    </p>

                    <table class=" table  table-borderless">
                        <thead>
                            <tr>
                                <th class="text-start">SL No.</th>
                                <th t-if="docs['filter_data'].get('is_unique_name') == False"
                                    class="text-end text-nowrap">Name
                                </th>
                                <th class="text-center text-nowrap">Pending
                                    Amount
                                </th>
                                <th t-if="docs['filter_data'].get('is_unique_room') == False" class="text-center text-nowrap">Room</th>
                                <th class="text-end text-nowrap">Invoice
                                    Status
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="sequence" t-value="0"/>
                            <t t-foreach="docs['report']" t-as="student">
                                <t t-set="sequence" t-value="sequence + 1"/>
                                <tr>
                                    <td t-out="sequence"
                                        class="text-start">value</td>
                                    <td t-if="docs['filter_data'].get('is_unique_name') == False"
                                        t-out="student.get('name')"
                                        class="text-end">value</td>
                                    <td t-out="student.get('monthly_payment')"
                                        class="text-center">value</td>
                                    <td t-if="docs['filter_data'].get('is_unique_room') == False" t-out="student.get('room_id')"
                                        class="text-center">value</td>
                                    <td t-out="student.get('invoice_status')"
                                        class="text-end">value</td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
<!--    LEAVE REQUEST REPORT TEMPLATE-->
    <template id="report_leave_request">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
               <div class="page">
                   <h2>Students Leave Request Report</h2>
                   <t t-if="docs['filter_data']">
                       <t t-if="docs['filter_data'].get('room_ids')">
                           <p>ROOM :
                               <t t-foreach="docs['filter_data'].get('room_ids')" t-as="rooms">
                                   <span t-out="rooms"></span>,
                               </t>
                           </p>
                       </t>
                   </t>
                   <t t-if="docs['filter_data']">
                       <t t-if="docs['filter_data'].get('student_ids')">
                           <p>STUDENT :
                               <t t-foreach="docs['filter_data'].get('student_ids')" t-as="student">
                                   <span t-out="student.upper()"></span>,
                               </t>
                           </p>
                       </t>
                   </t>
                   <t t-if="docs['filter_data']">
                       <t t-if="docs['filter_data'].get('start_date')">
                           <p>START DATE :
                                   <span t-out="docs['filter_data'].get('start_date')"></span>
                           </p>
                           <p>ARRIVAL DATE :
                                   <span t-out="docs['filter_data'].get('arrival_date')"></span>
                           </p>
                       </t>
                   </t>
                   <table class=" table  table-borderless">
                        <thead>
                            <tr>
                                <th class="text-start">SL No.</th>
                                <th
                                    class="text-center text-nowrap">Student
                                </th>
                                <th class="text-center text-nowrap">Room</th>
                                <th class="text-center text-nowrap">Start date</th>
                                <th class="text-center text-nowrap">Arrival date</th>
                                <th class="text-center text-nowrap">Duration</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="sequence" t-value="0" />
                            <t t-foreach="docs['report']" t-as="record">
                                <t t-set="sequence" t-value="sequence + 1"/>
                                <tr>
                                    <td t-out="sequence" class="text-start">value</td>
                                    <td t-out="record.get('student_id')" class="text-center">value</td>
                                    <td t-out="record.get('room_id')" class="text-center">value</td>
                                    <td t-out="record.get('leave_date')" class="text-center">value</td>
                                    <td t-out="record.get('arrival_date')" class="text-center">value</td>
                                    <td t-out="record.get('duration')" class="text-center">value</td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

               </div>
            </t>
        </t>
    </template>

<!--    STUDENT REPORT TEMPLATE VIA ACTION-->
    <template id="report_student_student_action">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2 class="text-center">Student Report</h2><br/>
                    <t t-foreach="docs" t-as="record">
                            <div class="d-inline-block" style=" width:100%;">
                                <div style=" width:30%;float:left;" class="text-center">
                                    <t t-if="record.image != False">
                                        <img t-att-src="image_data_uri(record.image)"/>
                                    </t>
                                    <t t-else="">
                                        <img src="hostel/static/img/placeholder.jpeg"  width="150" height="150"/>
                                    </t>

                                </div>
                                    <table style=" width:70%; top=10%" class="table table-borderless">
                                        <tbody>
                                            <tr>
                                                <td >NAME :</td>
                                                <td ><span t-out="record.name.upper()">value</span></td>
                                            </tr>
                                            <tr>
                                                <td >ID :</td>
                                                <td ><span t-out="record.student_id" >value</span></td>
                                            </tr>
                                            <tr>
                                                <td >DOB :</td>
                                                <td ><span t-out="record.dob">value</span></td>
                                            </tr>
                                            <tr>
                                                <td >EMAIL :</td>
                                                <td ><span t-out="record.email">value</span></td>
                                            </tr>
                                        </tbody>
                                    </table>

                            </div>
                        <p></p><br/>
                            <table class="table ">
                                <tbody>
                                    <t t-if="record.room_id">
                                    <tr>
                                        <td class="text-center">ROOM </td>
                                        <td t-out="record.room_id.room_no" class="text-center"></td>
                                    </tr>
                                    <tr>
                                        <td class="text-center">DUE </td>
                                        <td t-out="record.monthly_payment" class="text-center"></td>
                                    </tr>
                                    <tr>
                                        <td class="text-center">INVOICE STATUS</td>
                                        <td t-out="record.invoice_status" class="text-center"></td>
                                    </tr>
                                    </t>
                                    <t t-if="record.company_id.name">
                                    <tr>
                                        <td class="text-center">COMPANY </td>
                                        <td t-out="record.company_id.name" class="text-center"></td>
                                    </tr>

                                    </t>
                                    <t t-if="record.city">
                                    <tr>
                                        <td class="text-center">CITY </td>
                                        <td t-out="record.city" class="text-center"></td>
                                    </tr>
                                    </t>
                                    <t t-if="record.state_id.name">
                                    <tr>
                                        <td class="text-center">STATE </td>
                                        <td t-out="record.state_id.name" class="text-center"></td>
                                    </tr>
                                    </t>
                                    <t t-if="record.country_id.name">
                                    <tr>
                                        <td class="text-center">COUNTRY </td>
                                        <td t-out="record.country_id.name" class="text-center"></td>
                                    </tr>
                                    </t>
                                </tbody>
                            </table>

                    </t>
                </div>
            </t>
        </t>
    </template>
</odoo>

