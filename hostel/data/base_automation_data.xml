<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <data>
        <record id="action_auto_create_user1" model="ir.actions.server">
            <field name="name">Automated  User creation</field>
            <field name="model_id" ref="hostel.model_student_student"/>
            <field name="state">code</field>
            <field name="code">
                action = records.action_create_user()
            </field>
        </record>

        <record id="base_automation_create_user1" model="base.automation">
            <field name="name">Student Creation : Auto create User</field>
            <field name="model_id" ref="hostel.model_student_student"/>
            <field name="trigger">on_create</field>
            <field name="action_server_ids" eval="[(4,ref('hostel.action_auto_create_user1'))]"/>
        </record>
    </data>
</odoo>